# Keep only MPI sources, benchmark tooling, and Petri diagrams in Git.
/*
!/.gitignore
!/lab1/

/lab1/*
!/lab1/main.c
!/lab1/benchmark.c
!/lab1/Makefile
!/lab1/run.py
!/lab1/draw_petri.py
!/lab1/results/

/lab1/results/*
!/lab1/results/petri_False.png
!/lab1/results/petri_True.png
./skills

!/practical2/
/practical2/*
!/practical2/bench.py
!/practical2/minimum.c
!/practical2/draw_petri.py
!/practical2/petri.png
!/practical2/seconds.png
!/practical2/speed.png

!/lab3/
/lab3/*
!/lab3/README.md
!/lab3/main.c
!/lab3/benchmark.c
!/lab3/Makefile
!/lab3/bench.py
!/lab3/draw_petri.py
!/lab3/results/
/lab3/results/*
!/lab3/results/petri-*.png
!/lab3/results/time.png
!/lab3/results/speedup.png
!/lab4/
/lab4/*
!/lab4/main.c
!/lab4/benchmark.c
!/lab4/draw_petri.py
